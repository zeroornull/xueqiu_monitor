# 复制为 .env 后填写。Cookie 也可由 uv run python -m xueqiu_monitor.login 写入。

XUEQIU_COOKIE=
XUEQIU_ACCOUNT=
XUEQIU_PASSWORD=

# 通知渠道默认都关闭；要启用哪个就设为 true。缺凭证的渠道会被跳过，不影响监控循环。
DINGTALK_ENABLED=false
DINGTALK_WEBHOOK=
AT_ALL=false

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 飞书自建应用。把机器人拉进群后，把群 chat_id（oc_ 开头）填到 FEISHU_RECEIVE_ID
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_MODE=websocket
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=chat_id

# 组合代码，多个用英文逗号分隔
MONITORED_CUBES=ZH123456

# 钉钉可选加签。留空则保持原来的无加签机器人。
# DINGTALK_SECRET=

# 飞书群自定义机器人，和上面的自建应用可以同时开
# FEISHU_WEBHOOK_ENABLED=false
# FEISHU_WEBHOOK=
# FEISHU_WEBHOOK_SECRET=

# 企业微信群机器人
# WECOM_ENABLED=false
# WECOM_WEBHOOK=

# Slack incoming webhook
# SLACK_ENABLED=false
# SLACK_WEBHOOK=

# Discord webhook
# DISCORD_ENABLED=false
# DISCORD_WEBHOOK=

# 邮件。未设置 SMTP_SSL 时默认 STARTTLS，端口默认 587；SMTP_SSL=true 时端口默认 465。
# SMTP_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=
# SMTP_STARTTLS=true
# SMTP_SSL=false

# 通用 HTTP webhook。正文在 JSON 的 text，标题在 title。EXTRA 是可选 JSON 对象。
# HTTP_WEBHOOK_ENABLED=false
# HTTP_WEBHOOK_URL=
# HTTP_WEBHOOK_BEARER=
# HTTP_WEBHOOK_EXTRA=

# ntfy。SERVER 默认 https://ntfy.sh
# NTFY_ENABLED=false
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=
# NTFY_TOKEN=
# NTFY_PRIORITY=

# Gotify
# GOTIFY_ENABLED=false
# GOTIFY_SERVER=
# GOTIFY_TOKEN=
# GOTIFY_PRIORITY=5

# Pushover
# PUSHOVER_ENABLED=false
# PUSHOVER_USER=
# PUSHOVER_TOKEN=
# PUSHOVER_PRIORITY=

# Microsoft Teams Workflow incoming webhook
# TEAMS_ENABLED=false
# TEAMS_WEBHOOK=

# Matrix。一次 PUT 发到房间。
# MATRIX_ENABLED=false
# MATRIX_HOMESERVER=
# MATRIX_ROOM_ID=
# MATRIX_TOKEN=

# Server酱 Turbo
# SERVERCHAN_ENABLED=false
# SERVERCHAN_SENDKEY=

# PushPlus
# PUSHPLUS_ENABLED=false
# PUSHPLUS_TOKEN=
# PUSHPLUS_TOPIC=
# PUSHPLUS_TEMPLATE=markdown

# Bark。SERVER 默认 https://api.day.app
# BARK_ENABLED=false
# BARK_SERVER=https://api.day.app
# BARK_DEVICE_KEY=
# BARK_SOUND=
# BARK_GROUP=

# WxPusher。UID 和主题至少填一个，多个用英文逗号分隔。
# WXPUSHER_ENABLED=false
# WXPUSHER_APP_TOKEN=
# WXPUSHER_UIDS=
# WXPUSHER_TOPIC_IDS=

# PushDeer。SERVER 默认 https://api2.pushdeer.com
# PUSHDEER_ENABLED=false
# PUSHDEER_PUSHKEY=
# PUSHDEER_SERVER=https://api2.pushdeer.com

# 持仓快照路径，容器里用 /data/monitor_state.json
# STATE_FILE=monitor_state.json
# 检查间隔（秒），默认 300
CHECK_INTERVAL=300
# 仓位变动超过多少个百分点才通知。0 表示有变化就通知。
WEIGHT_CHANGE_THRESHOLD=0
LOG_FILE=xueqiu_monitor.log
