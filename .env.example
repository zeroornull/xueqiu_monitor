# 复制为 .env 后填写。Cookie 也可由 uv run python login.py 写入。

XUEQIU_COOKIE=
XUEQIU_ACCOUNT=
XUEQIU_PASSWORD=

# 两个通知渠道都可以关掉；要启用哪个就设为 true
DINGTALK_ENABLED=false
DINGTALK_WEBHOOK=
AT_ALL=false

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 飞书自建应用。把机器人拉进群后，把群 chat_id（oc_ 开头）填到 FEISHU_RECEIVE_ID
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_MODE=websocket
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=chat_id

# 组合代码，多个用英文逗号分隔
MONITORED_CUBES=ZH123456

# 持仓快照路径，容器里用 /data/monitor_state.json
# STATE_FILE=monitor_state.json
# 检查间隔（秒），默认 300
CHECK_INTERVAL=300
# 仓位变动超过多少个百分点才通知
WEIGHT_CHANGE_THRESHOLD=1.0
LOG_FILE=xueqiu_monitor.log
